{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist/e2e",
    "rootDir": "..",
    "baseUrl": "..",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../playwright.config.ts"],
  "exclude": ["../node_modules"]
}
